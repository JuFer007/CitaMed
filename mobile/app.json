{
  "expo": {
    "name": "CitaMed",
    "slug": "citamed",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "citamed",
    "icon": "./assets/logoCitaMed.png",
    "splash": {
      "image": "./assets/logoCitaMed.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.citamed.mobile"
    },
    "android": {
      "package": "com.citamed.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoCitaMed.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
